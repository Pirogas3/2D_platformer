  m_Name: 
  m_EditorClassIdentifier: 
  _mode: 0
  _bound:
    _sentences:
    - "\u041A\u0430\u043F\u0438\u0442\u0430\u043D \u041D\u043E\u0441: \u041F\u043E\u0445\u043E\u0436\u0435
      \u043A\u0430\u0440\u0442\u0430 \u0432\u0435\u043B\u0430 \u043D\u0430 \u044D\u0442\u043E\u0442
      \u043E\u0441\u0442\u0440\u043E\u0432"
    - "\u0417\u0434\u0435\u0441\u044C \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430"
    - "\u0425\u0430-\u0425\u0430, \u0438 \u044F \u0438\u0445 \u043D\u0430\u0439\u0434\u0443!"
    - "\u0416\u0430\u043B\u044C \u0442\u043E\u043B\u044C\u043A\u043E, \u0447\u0442\u043E
      \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u0440\u0430\u0437\u0431\u0438\u043B\u0441\u044F...
      \u0414\u0430 \u0438 \u0432\u0435\u0441\u044C \u044D\u043A\u0438\u043F\u0430\u0436
      \u0431\u043E\u0433 \u0437\u043D\u0430\u0435\u0442 \u0433\u0434\u0435, \u0432\u044B\u0436\u0438\u043B
      \u043B\u0438 \u043A\u0442\u043E-\u0442\u043E \u043A\u0440\u043E\u043C\u0435
      \u043C\u0435\u043D\u044F?"
    - "\u041F\u041E\u0414\u0421\u041A\u0410\u0417\u041A\u0410: \u0412\u044B \u0432\u0441\u0435\u0433\u0434\u0430
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u043A\u0443 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u0432 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445 \u0438\u0433\u0440\u044B
      (\u043F\u0440\u0430\u0432\u044B\u0439 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B)"
    _keys: []
  _external: {fileID: 0}
