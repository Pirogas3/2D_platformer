  _bound:
    _sentences:
    - "\u041A\u0430\u043F\u0438\u0442\u0430\u043D \u041D\u043E\u0441: \u041E, \u043A\u0430\u043A
      \u043D\u0435\u043B\u044C\u0437\u044F \u043A\u0441\u0442\u0430\u0442\u0438,
      \u0437\u0435\u043B\u044C\u0435 \u043B\u0435\u0447\u0435\u043D\u0438\u044F!"
    - "\u041B\u0443\u0447\u0448\u0435 \u0432\u044B\u043F\u0438\u0442\u044C \u044D\u0442\u043E
      \u0437\u0435\u043B\u044C\u0435, \u043A\u0442\u043E \u0437\u043D\u0430\u0435\u0442
      \u0447\u0442\u043E \u0434\u0430\u043B\u044C\u0448\u0435 \u043D\u0430\u0441
      \u0436\u0434\u0451\u0442?"
    - "\u041F\u041E\u0414\u0421\u041A\u0410\u0417\u041A\u0410: \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0437\u0435\u043B\u044C\u0435 (\u043F\u0440\u0430\u0432\u0430\u044F \u043A\u043D\u043E\u043F\u043A\u0430
      \u043C\u044B\u0448\u0438 \u043F\u043E \u0437\u0435\u043B\u044C\u044E \u0438\u0437
      \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F)"
